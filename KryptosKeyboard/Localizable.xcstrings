{
  "sourceLanguage": "en",
  "strings": {
    "Choose a contact first": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала выберите контакт"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle zuerst einen Kontakt"
          }
        }
      }
    },
    "Clear": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистить"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leeren"
          }
        }
      }
    },
    "Clipboard is empty.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Буфер обмена пуст."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zwischenablage ist leer."
          }
        }
      }
    },
    "Compose field": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поле ввода"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingabefeld"
          }
        }
      }
    },
    "Contact": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контакт"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontakt"
          }
        }
      }
    },
    "Could not decrypt — check the profile and contact": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось расшифровать — проверьте профиль и контакт"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entschlüsseln fehlgeschlagen — prüfe Profil und Kontakt"
          }
        }
      }
    },
    "Could not decrypt — different profile/contact, or the message is damaged": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось расшифровать — другой профиль/контакт или сообщение повреждено"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entschlüsseln fehlgeschlagen — anderes Profil bzw. anderer Kontakt, oder die Nachricht ist beschädigt"
          }
        }
      }
    },
    "Could not encrypt": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось зашифровать"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschlüsseln fehlgeschlagen"
          }
        }
      }
    },
    "Decrypted · %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расшифровано · %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entschlüsselt · %@"
          }
        }
      }
    },
    "Encrypted for %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зашифровано для %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschlüsselt für %@"
          }
        }
      }
    },
    "Enter some text.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите текст."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einen Text ein."
          }
        }
      }
    },
    "Locked — unlock to use encryption": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заблокировано — разблокируйте, чтобы пользоваться шифрованием"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesperrt — entsperre die App, um zu verschlüsseln"
          }
        }
      }
    },
    "No contacts in this profile": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В профиле нет контактов"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Kontakte in diesem Profil"
          }
        }
      }
    },
    "No message — paste it into the field or copy it": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет сообщения — вставьте его в поле или скопируйте"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Nachricht — füge sie in das Feld ein oder kopiere sie"
          }
        }
      }
    },
    "No recent emoji yet — pick a category below": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недавних эмодзи пока нет — выберите категорию ниже"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine zuletzt verwendeten Emoji — wähle unten eine Kategorie"
          }
        }
      }
    },
    "Open the Kryptos app and add a contact.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте приложение Kryptos и добавьте контакт."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die Kryptos-App und füge einen Kontakt hinzu."
          }
        }
      }
    },
    "Paste": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставить"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einfügen"
          }
        }
      }
    },
    "To encrypt, enable “Full Access” in the keyboard settings.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для шифрования включите «Полный доступ» в настройках клавиатуры."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere für die Verschlüsselung „Vollen Zugriff“ in den Tastatureinstellungen."
          }
        }
      }
    },
    "Type or paste text — the messenger won't see it until it's encrypted": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Печатайте или вставьте текст — мессенджер не увидит его до шифрования"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe oder füge Text ein — der Messenger sieht ihn erst, wenn er verschlüsselt ist"
          }
        }
      }
    },
    "Unlock Kryptos": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблокируйте Kryptos"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kryptos entsperren"
          }
        }
      }
    }
  },
  "version": "1.0"
}
