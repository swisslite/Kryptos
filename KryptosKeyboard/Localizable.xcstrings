{
  "sourceLanguage": "en",
  "strings": {
    "Choose a contact first": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle zuerst einen Kontakt"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نخست یک مخاطب انتخاب کنید"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала выберите контакт"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先选择联系人"
          }
        }
      }
    },
    "Clear": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leeren"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پاک کردن"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистить"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清空"
          }
        }
      }
    },
    "Clipboard is empty.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zwischenablage ist leer."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کلیپ‌بورد خالی است."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Буфер обмена пуст."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板为空。"
          }
        }
      }
    },
    "Compose field": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingabefeld"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فیلد نوشتن"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поле ввода"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入框"
          }
        }
      }
    },
    "Contact": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontakt"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مخاطب"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контакт"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "联系人"
          }
        }
      }
    },
    "Could not decrypt — check the profile and contact": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entschlüsseln fehlgeschlagen — prüfe Profil und Kontakt"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رمزگشایی نشد — نمایه و مخاطب را بررسی کنید"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось расшифровать — проверьте профиль и контакт"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解密失败——请检查个人资料和联系人"
          }
        }
      }
    },
    "Could not decrypt — different profile/contact, or the message is damaged": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entschlüsseln fehlgeschlagen — anderes Profil bzw. anderer Kontakt, oder die Nachricht ist beschädigt"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رمزگشایی نشد — نمایه یا مخاطب دیگری است، یا پیام آسیب دیده"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось расшифровать — другой профиль/контакт или сообщение повреждено"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解密失败——个人资料或联系人不对，或消息已损坏"
          }
        }
      }
    },
    "Could not encrypt": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschlüsseln fehlgeschlagen"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رمزگذاری نشد"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось зашифровать"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加密失败"
          }
        }
      }
    },
    "Decrypted · %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entschlüsselt · %@"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رمزگشایی‌شده · %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расшифровано · %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已解密 · %@"
          }
        }
      }
    },
    "Encrypted for %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschlüsselt für %@"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رمزگذاری‌شده برای %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зашифровано для %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已为 %@ 加密"
          }
        }
      }
    },
    "Enter some text.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einen Text ein."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "متنی وارد کنید."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите текст."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入文本。"
          }
        }
      }
    },
    "Locked — open Kryptos and unlock it": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesperrt — Kryptos öffnen und entsperren"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "قفل است — Kryptos را باز کنید و قفلش را بردارید"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заблокировано — откройте Kryptos и снимите блокировку"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已锁定 — 请打开 Kryptos 解锁"
          }
        }
      }
    },
    "Locked — unlock to use encryption": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesperrt — entsperre die App, um zu verschlüsseln"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "قفل است — برای استفاده از رمزگذاری قفل را باز کنید"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заблокировано — разблокируйте, чтобы пользоваться шифрованием"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已锁定——解锁后才能加密"
          }
        }
      }
    },
    "No contacts in this profile": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Kontakte in diesem Profil"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این نمایه مخاطبی ندارد"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В профиле нет контактов"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此个人资料中没有联系人"
          }
        }
      }
    },
    "No message — paste it into the field or copy it": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Nachricht — füge sie in das Feld ein oder kopiere sie"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیامی نیست — آن را در فیلد بچسبانید یا کپی کنید"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет сообщения — вставьте его в поле или скопируйте"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有消息——请粘贴到输入框或复制它"
          }
        }
      }
    },
    "No recent emoji yet — pick a category below": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine zuletzt verwendeten Emoji — wähle unten eine Kategorie"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنوز ایموجی اخیری نیست — از پایین یک دسته انتخاب کنید"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недавних эмодзи пока нет — выберите категорию ниже"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有最近使用的表情——请在下方选择分类"
          }
        }
      }
    },
    "Not available in a password field": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Passwortfeld nicht verfügbar"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در فیلد گذرواژه در دسترس نیست"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недоступно в поле пароля"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码输入框中不可用"
          }
        }
      }
    },
    "Open the Kryptos app and add a contact.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die Kryptos-App und füge einen Kontakt hinzu."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامه Kryptos را باز کنید و یک مخاطب اضافه کنید."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте приложение Kryptos и добавьте контакт."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请打开 Kryptos 应用并添加联系人。"
          }
        }
      }
    },
    "Paste": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einfügen"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "چسباندن"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставить"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴"
          }
        }
      }
    },
    "This app will not let the keyboard clear the field — encrypt in the Kryptos app instead.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App lässt die Tastatur das Feld nicht leeren - verschlüssle stattdessen in der Kryptos-App."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این برنامه اجازه نمی‌دهد صفحه‌کلید فیلد را پاک کند — به‌جای آن در برنامه Kryptos رمزگذاری کنید."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это приложение не даёт клавиатуре очистить поле — зашифруйте в приложении Kryptos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此应用不允许键盘清空输入框——请改在 Kryptos 应用中加密。"
          }
        }
      }
    },
    "To encrypt, enable “Full Access” in the keyboard settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere für die Verschlüsselung „Vollen Zugriff“ in den Tastatureinstellungen."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای رمزگذاری، «دسترسی کامل» را در تنظیمات صفحه‌کلید روشن کنید."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для шифрования включите «Полный доступ» в настройках клавиатуры."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要加密，请在键盘设置中开启“完全访问”。"
          }
        }
      }
    },
    "Type or paste text — the messenger won't see it until it's encrypted": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe oder füge Text ein — der Messenger sieht ihn erst, wenn er verschlüsselt ist"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بنویسید یا متن را بچسبانید — پیام‌رسان تا پیش از رمزگذاری آن را نمی‌بیند"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Печатайте или вставьте текст — мессенджер не увидит его до шифрования"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入或粘贴文本——加密之前通讯软件看不到它"
          }
        }
      }
    },
    "Unlock Kryptos": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kryptos entsperren"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "قفل Kryptos را باز کنید"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблокируйте Kryptos"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁 Kryptos"
          }
        }
      }
    }
  },
  "version": "1.0"
}
