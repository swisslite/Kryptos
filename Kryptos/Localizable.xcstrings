    "“This device only” keeps copied text off your other Apple devices. Auto-clear erases it after the chosen time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Nur dieses Gerät“ hält Kopiertes von deinen anderen Apple-Geräten fern. Die Auto-Löschung entfernt es nach der gewählten Zeit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Только это устройство» — скопированное не уходит на другие устройства Apple. Автоочистка стирает его через заданное время."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“仅限本设备”可防止复制的文本同步到你的其他 Apple 设备。自动清空会在设定时间后清除它。"
          }
        }
      }
    }
