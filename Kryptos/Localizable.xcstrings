    "Regenerate this key? The public key you shared before will stop working.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Schlüssel neu erzeugen? Der zuvor weitergegebene öffentliche Schlüssel funktioniert dann nicht mehr."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کلید از نو ساخته شود؟ کلید عمومی‌ای که پیش‌تر به اشتراک گذاشته‌اید از کار می‌افتد."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перегенерировать этот ключ? Публичный ключ, которым вы делились ранее, перестанет работать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新生成此密钥？你之前分享出去的公钥将失效。"
          }
        }
      }
    },
    "Regenerate this profile?": {
