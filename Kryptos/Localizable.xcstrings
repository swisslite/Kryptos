    "Camera access is off, so the QR scanner cannot open. Allow the camera in Settings, or paste the key as text.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к камере выключен, поэтому сканер QR не открывается. Разрешите камеру в Настройках или вставьте ключ текстом."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kamerazugriff ist deaktiviert, deshalb lässt sich der QR-Scanner nicht öffnen. Erlaube die Kamera in den Einstellungen oder füge den Schlüssel als Text ein."
          }
        }
      }
    },
    "Can I send a photo or a file through Kryptos?": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно ли отправить через Kryptos фотографию или файл?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kann ich über Kryptos ein Foto oder eine Datei senden?"
          }
        }
      }
    },
    "Can I use one key on two phones?": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно ли пользоваться одним ключом на двух телефонах?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kann ich einen Schlüssel auf zwei Telefonen verwenden?"
          }
        }
      }
    },
    "Can the messenger read my messages?": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
