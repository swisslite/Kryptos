    "Encrypt a message, send the result through any messenger, and paste their reply here to decrypt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschlüssle eine Nachricht, sende das Ergebnis über einen beliebigen Messenger und füge die Antwort hier zum Entschlüsseln ein."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیامی را رمزگذاری کنید، نتیجه را با هر پیام‌رسانی بفرستید و پاسخ او را برای رمزگشایی اینجا بچسبانید."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зашифруйте сообщение, отправьте результат через любой мессенджер, а ответ вставьте сюда для расшифровки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加密一条消息，通过任意通讯软件发送结果，再把对方的回复粘贴到这里解密。"
          }
        }
      }
    },
    "Encrypt anywhere. Talk over any channel.": {
      "localizations": {
