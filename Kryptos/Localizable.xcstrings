    "Enable the keyboard and Full Access": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите клавиатуру и полный доступ"
          }
        }
      }
    },
    "Encrypt": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зашифровать"
          }
        }
      }
    },
    "Encrypt a message, send the result through any messenger, and paste their reply here to decrypt.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зашифруйте сообщение, отправьте результат через любой мессенджер, а ответ вставьте сюда для расшифровки."
          }
        }
      }
    },
    "Encrypt anywhere. Talk over any channel.": {
      "localizations": {
