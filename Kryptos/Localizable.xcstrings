    "Delete contacts & chats": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontakte & Chats löschen"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف مخاطبان و گفت‌وگوها"
          }
        },
