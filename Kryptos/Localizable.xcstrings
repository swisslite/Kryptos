    "Replace the keys on this device with the ones from the backup? The keys currently here will be gone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schlüssel auf diesem Gerät durch die aus dem Backup ersetzen? Die Schlüssel, die sich derzeit hier befinden, gehen verloren."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کلیدهای این دستگاه با کلیدهای پشتیبان جایگزین شوند؟ کلیدهای کنونی از میان می‌روند."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заменить ключи на этом устройстве ключами из копии? Те, что здесь сейчас, будут удалены."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用备份中的密钥替换本设备上的密钥？当前设备上的密钥将丢失。"
          }
        }
      }
    },
