          "stringUnit": {
            "state": "translated",
            "value": "Управление личностями…"
          }
        }
      }
    },
    "Mask message length": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Маскировать длину сообщения"
          }
        }
      }
    },
    "Message": {
      "localizations": {
