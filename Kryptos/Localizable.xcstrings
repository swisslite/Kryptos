          "stringUnit": {
            "state": "translated",
            "value": "Сообщение"
          }
        }
      }
    },
    "Message decrypted": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщение расшифровано"
          }
        }
      }
    },
    "Message field in the keyboard": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поле ввода в клавиатуре"
          }
        }
      }
    },
    "Messages disappear after %@.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщения исчезают через %@."
          }
        }
      }
    },
    "Metadata": {
      "localizations": {
