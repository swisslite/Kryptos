    "At least 4 characters. It must be different from the panic password.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Минимум 4 символа. Он должен отличаться от пароля-ловушки."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindestens 4 Zeichen. Er muss sich vom Panik-Passwort unterscheiden."
          }
        }
      }
    },
    "At least 4 characters. Pick something you would never type by accident.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Минимум 4 символа. Выберите то, что не введёте случайно."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindestens 4 Zeichen. Wähle etwas, das du nie versehentlich eingibst."
          }
        }
      }
    },
    "At least 8 characters. Keep the file and the password apart.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Минимум 8 символов. Храните файл и пароль отдельно."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindestens 8 Zeichen. Bewahre Datei und Passwort getrennt auf."
          }
        }
      }
    },
