          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinzufügen"
          }
        }
      }
    },
    "Add a recipient first": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала добавьте получателя"
          }
        },
        "de": {
