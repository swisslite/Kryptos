            "state": "translated",
            "value": "文本中未找到 Kryptos 消息。"
          }
        }
      }
    },
    "No PGP key is selected.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist kein PGP-Schlüssel ausgewählt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PGP-ключ не выбран."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未选择 PGP 密钥。"
          }
        }
      }
    },
    "No PGP message found.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine PGP-Nachricht gefunden."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PGP-сообщение не найдено."
          }
        },
        "zh-Hans": {
