    "Send it as a document/file. Sending it as a normal photo will recompress it and destroy the hidden data.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sende es als Dokument bzw. Datei. Als normales Foto verschickt, wird es neu komprimiert und die versteckten Daten werden zerstört."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آن را به‌صورت سند یا فایل بفرستید. ارسال به‌صورت عکس معمولی آن را دوباره فشرده می‌کند و داده پنهان از بین می‌رود."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляйте как документ/файл. Если отправить как обычное фото, оно пережмётся и скрытые данные пропадут."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请以文档／文件形式发送。若作为普通照片发送，它会被重新压缩，隐藏的数据将被破坏。"
          }
        }
      }
    },
