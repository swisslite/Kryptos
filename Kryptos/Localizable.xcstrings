    },
    "soon": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "bald"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به‌زودی"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "скоро"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即将推出"
          }
        }
      }
    },
    "“This device only” keeps copied text off your other Apple devices, except your public key. Auto-clear erases it after the chosen time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Nur dieses Gerät“ hält Kopiertes von deinen anderen Apple-Geräten fern, außer deinem öffentlichen Schlüssel. Die Auto-Löschung entfernt es nach der gewählten Zeit."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "«فقط همین دستگاه» متن کپی‌شده را، به جز کلید عمومی‌تان، از دستگاه‌های اپل دیگرتان دور نگه می‌دارد. پاک‌سازی خودکار آن را پس از زمان انتخابی پاک می‌کند."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Только это устройство» — скопированное не уходит на другие устройства Apple, кроме открытого ключа. Автоочистка стирает его через заданное время."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“仅限本设备”可防止复制的文本同步到你的其他 Apple 设备，公钥除外。自动清空会在设定时间后清除它。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
