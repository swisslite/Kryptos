      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось зашифровать сообщение."
          }
        }
      }
    },
    "Could not generate the key.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сгенерировать ключ."
          }
        }
      }
    },
    "Could not hide the message.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось спрятать сообщение."
          }
        }
      }
    },
    "Could not process the message.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось обработать сообщение."
          }
        }
      }
    },
    "Could not read the file.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать файл."
          }
        }
      }
    },
    "Could not read the photo.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать фото."
          }
        }
      }
    },
    "Could not read this backup — wrong password, or the file is not a Kryptos key backup.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
