      }
    },
    "Forget learned words": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Забыть выученные слова"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelernte Wörter vergessen"
          }
        }
      }
    },
    "Forget the words the keyboard has learned from your typing? The built-in dictionaries stay.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Забыть слова, которые клавиатура выучила при наборе? Встроенные словари останутся."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wörter vergessen, die die Tastatur beim Tippen gelernt hat? Die integrierten Wörterbücher bleiben erhalten."
          }
        }
      }
    },
    "Fully offline": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полностью офлайн"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vollständig offline"
          }
        }
      }
    },
    "Fully offline: no servers, no accounts, no analytics. Keys never leave the device.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полностью офлайн: без серверов, аккаунтов и аналитики. Ключи не покидают устройство."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vollständig offline: keine Server, Konten, Analysen. Schlüssel verlassen das Gerät nie."
          }
        }
      }
    },
    "Generate key": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сгенерировать ключ"
          }
        },
        "de": {
